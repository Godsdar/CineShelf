# Copy to .env and adjust as needed. Never commit real credentials.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=movies
POSTGRES_PORT=5432

DATABASE_URL=postgres://app:change-me@localhost:5432/movies

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me
# Must match the URL the app is served from (dev runs HTTPS by default).
AUTH_URL=https://localhost:3000
# Behind a proxy (Vercel, etc.) set this to true so Auth.js trusts the host.
# AUTH_TRUST_HOST=true

# OAuth providers (optional; the sign-in page only shows configured ones)
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Magic-link email. Leave EMAIL_SERVER empty in dev to print the link to the
# terminal instead of sending mail.
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=CineShelf <no-reply@cineshelf.local>
